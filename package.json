{
  "name": "qiankun-vite-test",
  "version": "0.0.2",
  "description": "qiankun demo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run start",
    "start": "pnpm -r --parallel --filter ./packages/main --filter ./packages/vue --filter ./packages/vue3 --filter ./packages/vue2-main --filter ./packages/vue3Vite run start",
    "build": "pnpm -r run build",
    "build:vue": "pnpm --filter ./packages/vue run build",
    "build:main": "pnpm --filter ./packages/main run build"
  },
  "devDependencies": {
    "@vue/cli-plugin-eslint": "~4.5.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.8.0",
    "lerna": "^8.2.2",
    "eslint-plugin-vue": "^7.20.0"
  },
  "keywords": [
    "vite2",
    "vue3",
    "qiankun",
    "qiankun-example",
    "demo"
  ],
  "author": "mj",
  "license": "MIT"
}
